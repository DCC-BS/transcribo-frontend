{
    "name": "transcribo-frontend",
    "version": "2.0.3",
    "private": true,
    "scripts": {
        "dev": "varlock run -- nuxt dev",
        "build": "nuxt build",
        "debug": "varlock run -- nuxt dev --inspect",
        "dummy": "AUTH_MODE=none DUMMY=true varlock run -- nuxt dev",
        "start": "nuxt start",
        "generate": "nuxt generate",
        "lint": "biome check",
        "lint:fix": "biome check --fix",
        "format": "biome format --write",
        "check": "biome check --fix",
        "ci": "biome ci .",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "docker:dev": "docker compose -f ./docker-compose.dev.yml up --build -d",
        "docker:prod": "docker compose -f ./docker-compose.yml up --build -d",
        "docker:dev:down": "docker compose -f ./docker-compose.dev.yml down",
        "docker:prod:down": "docker compose -f ./docker-compose.yml down",
        "env:check": "bunx varlock load"
    },
    "dependencies": {
        "@dcc-bs/audio-recorder.bs.js": "2.1.4",
        "@dcc-bs/common-ui.bs.js": "2.1.10",
        "@dcc-bs/communication.bs.js": "0.1.3",
        "@dcc-bs/event-system.bs.js": "^1.4.3",
        "@ffmpeg/ffmpeg": "^0.12.15",
        "@ffmpeg/util": "^0.12.2",
        "@iconify-json/lucide": "1.2.123",
        "@mohtasham/md-to-docx": "3.0.1",
        "@nuxt/ui": "4.10.0",
        "@nuxtjs/i18n": "10.6.0",
        "@nuxtjs/mdc": "0.23.1",
        "@tiptap/pm": "3.30.1",
        "@tiptap/starter-kit": "3.30.1",
        "@tiptap/vue-3": "3.30.1",
        "@vite-pwa/nuxt": "1.1.1",
        "@vueuse/core": "^14.4.0",
        "dexie": "^4.4.4",
        "konva": "10.3.0",
        "motion-v": "2.3.0",
        "nuxt": "4.5.2",
        "pino": "10.3.1",
        "ts-pattern": "^5.9.0",
        "uuid": "^14.0.1",
        "varlock": "^1.16.1",
        "vue": "3.5.41",
        "vue-konva": "3.4.0",
        "vue-tsc": "3.3.9",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.7",
        "@nuxt/test-utils": "^4.0.3",
        "@types/bun": "1.4.0",
        "@varlock/proton-pass-plugin": "^2.0.0",
        "@varlock/vite-integration": "^1.4.0",
        "@vitest/coverage-v8": "^4.1.10",
        "@vue/test-utils": "^2.4.11",
        "happy-dom": "20.11.2",
        "jiti": "^2.7.0",
        "msw": "^2.15.0",
        "pino-pretty": "^13.1.3",
        "sass": "1.102.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    },
    "overrides": {
        "vue": "3.5.41"
    }
}
