# Dev-only variables (Proton Pass secrets)
#
# Loaded only when APP_MODE=dev (see the @import in .env.runtime.schema). This
# keeps the proton-pass plugin and its protonPass() resolver calls out of the
# production build, so varlock never has to fetch the plugin from npm at
# runtime and prod secrets are never resolved here.
# @plugin(@varlock/proton-pass-plugin@^2.0.0)
# @initProtonPass()
# @defaultSensitive=false
# ---

# GitHub token for the feedback feature (dev only)
# @sensitive @required=$USE_FEEDBACK
NUXT_FEEDBACK_GITHUB_TOKEN=if(
    eq($APP_MODE, dev), protonPass("pass://DCC-KI/FEEDBACK_DEV_GITHUB_TOKEN/TOKEN", allowMissing=true),
)
